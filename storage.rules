rules_version = '2';

// Photos and documents for Himat Textile.
//
// READ IS SPLIT INTO get AND list ON PURPOSE. This is the important part of this file.
//
// After an upload the app calls getDownloadURL() to get the permanent link it stores on the record.
// That call is an SDK read, so it needs `get`. Both public registration forms upload BEFORE their
// user is signed in — the customer form collects KYC photos on step 3 and only verifies the phone OTP
// at the very end, and the supplier form has no sign-in at all. So requiring a signed-in user for
// `get` breaks every public upload: the file lands, then the link cannot be read back.
//
// `list` is a different thing and stays closed. Nobody without an account should be able to walk the
// kyc/ folder and see what is in it.
//
// Also worth knowing: a Firebase download URL (`...?alt=media&token=...`) is served WITHOUT
// consulting these rules — the token in the link is the permission. So opening `get` on the public
// upload folders gives away nothing that the stored links do not already give away, and closing it
// would not have protected them either.
//
// What this file allows:
//   - the public customer and supplier registration forms may CREATE files and read back the link for
//     what they just uploaded, and nothing else: they cannot list, replace or remove;
//   - a signed-in member may read, list, upload and replace anywhere the app uses;
//   - every upload is capped at 15 MB and must be an image or a PDF.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function sizeOk() {
      return request.resource != null && request.resource.size < 15 * 1024 * 1024;
    }

    function typeOk() {
      return request.resource != null
          && (request.resource.contentType.matches('image/.*')
              || request.resource.contentType == 'application/pdf');
    }

    // ---------------------------------------------------------------------
    // Public registration forms — upload and read back the link, no sign-in
    //
    // The folder names match what the forms actually pass to FileUpload. The whole `suppliers/`
    // subtree is covered because the supplier form writes to suppliers/shop, suppliers/godown and
    // suppliers/cards, while these rules used to name only suppliers/shop_photos and
    // suppliers/visiting_cards — so those uploads fell through to the catch-all and were refused.
    // ---------------------------------------------------------------------

    match /registrations/{allPaths=**} {
      allow get: if true;
      allow list: if signedIn();
      allow create: if sizeOk() && typeOk();
      allow update, delete: if signedIn();
    }

    // Customer KYC: shop front, GST certificate, PAN, Aadhaar front and back, cancelled cheque,
    // owner selfie. Uploaded on step 3, before the phone OTP at the end of the form.
    match /kyc/{allPaths=**} {
      allow get: if true;
      allow list: if signedIn();
      allow create: if sizeOk() && typeOk();
      allow update, delete: if signedIn();
    }

    // Supplier form: shop photo, godown photo, visiting card. No sign-in anywhere in this form.
    match /suppliers/{allPaths=**} {
      allow get: if true;
      allow list: if signedIn();
      allow create: if sizeOk() && typeOk();
      allow update, delete: if signedIn();
    }

    // ---------------------------------------------------------------------
    // Everything the signed-in app uploads: customers, employees, brands, leads, purchase_orders,
    // cheques, reports and any per-record subfolder under them.
    // ---------------------------------------------------------------------
    match /{allPaths=**} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow write: if signedIn() && sizeOk() && typeOk();
      allow delete: if signedIn();
    }
  }
}
