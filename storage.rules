rules_version = '2';

// Photos and documents for Himat Textile.
//
// Reading stays open. Report PDFs, shop photos and invoice images are shared as plain links over
// WhatsApp, so locking reads would break every link already sent to a customer or supplier.
//
// Writing was open to the whole internet. Now:
//   - a signed-in member of the agency may upload anywhere the app uses;
//   - the public customer and supplier registration forms may still upload, because the person
//     filling them has no account yet, but only into their own folders;
//   - every upload is capped at 15 MB and must be an image or a PDF;
//   - nothing may be deleted or overwritten without being signed in.
service firebase.storage {
  match /b/{bucket}/o {

    function sizeOk() {
      return request.resource != null && request.resource.size < 15 * 1024 * 1024;
    }

    function typeOk() {
      return request.resource != null
          && (request.resource.contentType.matches('image/.*')
              || request.resource.contentType == 'application/pdf');
    }

    // Public registration forms (shop photo, GST certificate, ID proof) - no sign-in yet.
    // Create only: an existing file cannot be replaced or removed anonymously.
    match /registrations/{allPaths=**} {
      allow read: if true;
      allow create: if sizeOk() && typeOk();
      allow update, delete: if request.auth != null;
    }
    match /suppliers/visiting_cards/{allPaths=**} {
      allow read: if true;
      allow create: if sizeOk() && typeOk();
      allow update, delete: if request.auth != null;
    }
    match /suppliers/shop_photos/{allPaths=**} {
      allow read: if true;
      allow create: if sizeOk() && typeOk();
      allow update, delete: if request.auth != null;
    }
    match /kyc/{allPaths=**} {
      allow read: if true;
      allow create: if sizeOk() && typeOk();
      allow update, delete: if request.auth != null;
    }

    // Everything else the signed-in app uploads: customers, suppliers, employees, brands, leads,
    // purchase_orders, cheques, reports and any per-record subfolder under them.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && sizeOk() && typeOk();
      allow delete: if request.auth != null;
    }
  }
}
