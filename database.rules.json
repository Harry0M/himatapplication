      "$key": {
        ".write": "auth != null && (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists()))"
      }
    },
    "tombstones": {
      ".read": "auth != null && (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists()))",
      ".write": false
    }
  }
}
