// Himat Textile - Realtime Database rules.
//
// Members: any signed-in Google account the app recognises. Owners (Admins) are listed under
// super_admins, keyed by email with '.' -> '_' and '@' -> '_at_' (the same key sanitizeEmail on
// Android and emailKey on the web build); the web also keeps a copy keyed by uid.
//
// Access: every signed-in member reads and writes the whole working set, on purpose. The agency runs
// one shared book - an admin and every staff member must be able to see and continue anybody else's
// trips and orders. Sub Agents are scoped inside the app, not here.
//
// What is locked down:
//   * super_admins: only an existing owner adds or removes an owner. The first sign-in on an empty
//     database may claim ownership, which is how a fresh deployment bootstraps.
//   * No node can be wiped in one call: writes are allowed per record, never on a whole node.
//   * Only an owner may REMOVE a record. Everyone else can create and update but never delete.
//     Normal deletion goes through the isDeleted flag plus a deletion_requests entry that an owner
//     confirms. This is the rule that stops a stale or buggy client from destroying real orders.
//   * Public registration forms may only create a new request, never overwrite or delete one.
//   * Record ids must be numeric strings, matching the client id generator.
//
// Generated by .kiro/backups/gen-rules.ps1 so the long owner expression cannot drift.
{
  "rules": {
    ".read": "auth != null",
    ".write": false,
    "super_admins": {
      ".read": "auth != null",
      ".write": false,
      "$key": {
        ".write": "auth != null && (!root.child('super_admins').exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists())))",
        ".validate": "!newData.exists() || newData.hasChildren(['email'])"
      }
    },
    "employees": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null && (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists())))",
        ".validate": "$id.matches(/^[0-9]+$/)"
      }
    },
    "customers": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null && (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists())))",
        ".validate": "$id.matches(/^[0-9]+$/)"
      }
    },
    "suppliers": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null && (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists())))",
        ".validate": "$id.matches(/^[0-9]+$/)"
      }
    },
    "visits": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null && (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists())))",
        ".validate": "$id.matches(/^[0-9]+$/)"
      }
    },
    "purchase_entries": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null && (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists())))",
        ".validate": "$id.matches(/^[0-9]+$/)"
      }
    },
    "products": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null && (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists())))",
        ".validate": "$id.matches(/^[0-9]+$/)"
      }
    },
    "brands": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null && (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists())))",
        ".validate": "$id.matches(/^[0-9]+$/)"
      }
    },
    "transporters": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null && (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists())))",
        ".validate": "$id.matches(/^[0-9]+$/)"
      }
    },
    "transactions": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null && (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists())))",
        ".validate": "$id.matches(/^[0-9]+$/)"
      }
    },
    "markets": {
      ".read": true,
      ".write": false,
      "$id": {
        ".write": "auth != null && (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists())))",
        ".validate": "$id.matches(/^[0-9]+$/)"
      }
    },
    "manufacturers": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null",
        ".validate": "$id.matches(/^[0-9]+$/)"
      }
    },
    "pack_groups": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null",
        ".validate": "$id.matches(/^[0-9]+$/)"
      }
    },
    "cheques_pdc": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null",
        ".validate": "$id.matches(/^[0-9]+$/)"
      }
    },
    "leads": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null"
      }
    },
    "counters": {
      ".read": "auth != null",
      ".write": false,
      "orderNo": {
        ".write": "auth != null",
        ".validate": "newData.isNumber() && (!data.exists() || newData.val() > data.val())"
      },
      "$other": {
        ".write": "auth != null"
      }
    },
    "deletion_requests": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null && (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists())))"
      }
    },
    "fcm_tokens": {
      ".read": "auth != null",
      ".write": false,
      "$token": {
        ".write": "auth != null",
        ".validate": "!newData.exists() || newData.hasChildren(['token', 'role'])"
      }
    },
    "notifications": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": "createdAt",
      "$id": {
        ".write": "auth != null && (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists())))",
        ".validate": "!newData.exists() || newData.hasChildren(['type', 'createdAt'])"
      }
    },
    "customer_registration_requests": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null ? (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists()))) : !data.exists()"
      }
    },
    "supplier_registration_requests": {
      ".read": "auth != null",
      ".write": false,
      "$id": {
        ".write": "auth != null ? (newData.exists() || (auth.token.email != null && (root.child('super_admins').child(auth.token.email.toLowerCase().replace('.', '_').replace('@', '_at_')).exists() || root.child('super_admins').child(auth.uid).exists()))) : !data.exists()"
      }
    }
  }
}
